# Test keyword: unset
unset var
# <- keyword
#     ^ variable

# Test keyword: variable
variable myVar 42
# <- keyword
#        ^ variable

$myvar
# <- variable
${myvar}
# <- variable
#^ punctuation.delimiter
#  ^ variable
"${myvar}"
# <- string
#   ^ variable
#        ^ string
"$myvar"
# <- string
#   ^ variable

# $tmm_id is a built-in scalar; the id inside must highlight as
# @variable.builtin, not the generic @variable.
$tmm_id
# <- variable
# ^ variable.builtin

set x $tmm_id
# <- keyword
#   ^ variable
#     ^ variable
#      ^ variable.builtin

# static:: namespace variables persist across event invocations.
# set target with static:: prefix:
set static::my_table "data"
# <- keyword
#   ^ variable.builtin

# $static::foo as a set value (parser keeps full namespace-qualified id):
set val $static::foo
# <- keyword
#   ^ variable
#       ^ variable
#        ^ variable.builtin

# $static::counter inside an expr (parser also keeps the full id):
if { $static::counter > 0 } {}
#    ^ variable
#     ^ variable.builtin

# Plain (non-static) set target. The generic capture in highlights.scm
# is gated by a #not-match? predicate that excludes the static prefix,
# so this assertion pins the negative branch of that predicate.
set ordinary_var 1
#   ^ variable

# Braced set targets must produce an (id) child so the same target
# captures fire as the bare spelling (regression for #19).
set ${plain_var} 1
#     ^ variable
set ${static::foo} 1
#     ^ variable.builtin
